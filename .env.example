# Copy to .env: `cp .env.example .env`. Used by `docker compose up` for
# variable substitution in docker-compose.yml. Defaults are for local dev
# only - change them before this ever touches a shared or public network.

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flash_cashback
DB_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8080

APP_TIMEZONE=Asia/Jakarta

# --- Only needed if running the Go binary directly
# --- (`go run ./backend/cmd/api`) instead of through docker compose.
# --- Compose sets these itself for the backend container.
# HTTP_PORT=8080
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/flash_cashback?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
