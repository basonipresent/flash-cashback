# Copy to .env and adjust as needed. Used by `expo start` — EXPO_PUBLIC_*
# vars are inlined into the JS bundle at build/start time.
#
# IMPORTANT: `localhost` / `127.0.0.1` will NOT work when running on a
# physical phone via Expo Go — the phone is a separate device on the
# network, not the same machine as your laptop. Use your laptop's LAN IP
# instead. Find it with `ipconfig` (Windows) or `ifconfig` / `ip addr`
# (macOS/Linux). `make up` publishes the backend on the host at this port,
# so it's reachable from other devices on the same network.
EXPO_PUBLIC_API_URL=http://192.168.1.23:8080
